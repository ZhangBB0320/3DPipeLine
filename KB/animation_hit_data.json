  "formula": {
    "description": "攻击配表计算公式",
    "inputs": {
      "animDuration": "动画原始时长(1.0x速率)",
      "hitPercent": "伤害触发百分比",
      "totalCycle": "期望总攻击周期(秒)",
      "animRatio": "动画压缩系数(默认0.8)"
    },
    "outputs": {
      "animPlayDuration": "totalCycle * animRatio",
      "hitTime": "animPlayDuration * hitPercent (即 TimeLines[0])",
      "cd": "totalCycle - hitTime",
      "animSpeed": "animDuration / animPlayDuration"
    },
